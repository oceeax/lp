<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ============ 网络 ============ -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- ============ 存储 ============ -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

    <!-- 媒体读取（Android 13+） -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <!-- ============ 相机 ============ -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />

    <!-- ============ 蓝牙 ============ -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- 若要扫描周边设备还需加，用不到可删 -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />

    <!-- ============ 开机启动 ============ -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- ============ 亮屏唤醒 ============ -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- ============ 前台服务 ============ -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- ============ 通知 ============ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- ============ 悬浮窗、修改系统设置、电池白名单 ============ -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:allowBackup="false"
        android:label="梭鱼湾"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:usesCleartextTraffic="true">

        <!-- FileProvider 图片视频本地文件访问 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- ========= Activity 所有可见页面 ========= -->
        <!-- 设置页面 -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false" />

        <!-- 定时器页面 -->
        <activity
            android:name=".AlarmSchedulerActivity"
            android:exported="false" />

        <!-- 数据上传页面 -->
        <activity
            android:name=".DeviceUploader"
            android:exported="false" />

        <!-- 语音播报页面 -->
        <activity
            android:name=".VoiceReader"
            android:exported="false" />

        <activity
            android:name=".MultiWsActivity"
            android:exported="false"
            android:label="五路接收" />
        <activity android:name=".LogManager" android:exported="false" />
        <activity android:name=".WebMonitor" android:exported="false" />

        <!-- ★ 新增：相机页面 -->
        <activity
            android:name=".CameraActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- 主界面【唯一桌面图标入口】 -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 浏览器 -->
        <activity
            android:name=".BrowserActivity"
            android:exported="false"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize" />

        <!-- 定时-->
        <activity
            android:name=".WhiteListUtil"
            android:exported="false" />
        <!-- 日志  -->
        <activity
            android:name=".LogManagerActivity"
            android:exported="false" />
        <activity
            android:name=".BootReceiver"
            android:exported="false" />
        <activity
            android:name=".CommandPoller"
            android:exported="false"
            android:configChanges="orientation|screenSize" />
        <activity
            android:name=".VideoPlay"
            android:exported="false"
            android:configChanges="orientation|screenSize" />

        <!-- ========= Service 后台服务（无界面） ========= -->
        <!-- 无障碍点击服务 -->
        <service
            android:name=".AppClickAccessService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
        </service>

        <!-- 悬浮窗服务 -->
        <service
            android:name=".FloatWindowService"
            android:exported="false" />

        <!-- 语音播报后台子服务，被VoiceReader页面调用 -->
        <service
            android:name=".ReaderService"
            android:exported="false" />

        <!-- 保持屏幕唤醒前台服务 -->
        <service
            android:name=".ScreenWakeService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Brief post‑boot screen wake attempt and visible five‑minute display" />
        </service>

        <!-- 循环任务前台服务 -->
        <service
            android:name=".CycleService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- ========= Receiver 广播接收器 ========= -->
        <!-- 开机广播：负责开机完成后做亮屏唤醒逻辑 BootReceiver.java -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- 定时任务广播接收器 -->
        <receiver
            android:name=".TaskReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.example.screenwake.ACTION_TIMER" />
            </intent-filter>
        </receiver>

    </application>
</manifest>

